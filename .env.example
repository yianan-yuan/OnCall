# =============================================================================
# docker-compose 的本地变量模板
# 用法：复制成同目录下的 .env，填上自己的值（.env 已被 .gitignore 忽略）
# =============================================================================

# 飞书群机器人的 Webhook 地址（飞书群 → 设置 → 群机器人 → 自定义机器人）
FEISHU_WEBHOOK_URL=

# 机器人开了"签名校验"才需要填，否则留空
FEISHU_SECRET=
